# C++: ISO/IEC 14882:2024 (C++23); requirements/languages/cpp.md
name     cpp c++ cxx cc hpp arduino ino

keyword  alignas alignof and and_eq asm auto bitand bitor break case catch class compl
keyword  concept const consteval constexpr constinit const_cast continue co_await co_return co_yield
keyword  decltype default delete do dynamic_cast else enum explicit export extern for friend goto if
keyword  inline mutable namespace new noexcept not not_eq operator or or_eq private protected public
keyword  register reinterpret_cast requires return sizeof static static_assert static_cast struct
keyword  switch template this thread_local throw try typedef typeid typename union using virtual
keyword  volatile while xor xor_eq final override import module
type     bool char double float int long short signed unsigned void _Bool _Complex _Imaginary _BitInt
type     _Decimal32 _Decimal64 _Decimal128 size_t ptrdiff_t intptr_t uintptr_t intmax_t uintmax_t wchar_t
type     char8_t char16_t char32_t int8_t int16_t int32_t int64_t uint8_t uint16_t uint32_t uint64_t
builtin  true false nullptr NULL

line-comment   //
block-comment  /* */
string   " "  : escapes
string   ' '  : escapes
prefix   u8 u U L
escape        : continuation x=any octal=3 u4 U8
number        : quote-sep
operators  +-*/%&|^!<>=:?~
calls
hook     cpp

# JavaScript: ECMAScript 2024 (ECMA-262, 15th edition); requirements/languages/javascript.md
name     javascript js mjs cjs

keyword  async await break case catch class const continue debugger default delete
keyword  do else enum export extends finally for function if implements import in instanceof interface let new
keyword  package private protected public return static super switch this throw try typeof var void while with
keyword  yield
builtin  true false null undefined NaN Infinity

ident-extra    $
line-comment   //
block-comment  /* */
string   " "  : escapes
string   ' '  : escapes
escape        : continuation x=2 u4 u-braces
operators  +-*/%&|^!<>=:?~
calls
decorators
templates
regex

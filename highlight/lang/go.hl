# Go: The Go Programming Language Specification (Go 1.22); requirements/languages/go.md
name     go golang

keyword  break case chan const continue default defer else fallthrough for func go goto
keyword  if import interface map package range return select struct switch type var
type     any bool byte comparable complex64 complex128 error float32 float64
type     int int8 int16 int32 int64 rune string uint uint8 uint16 uint32 uint64 uintptr
builtin  true false iota nil append cap clear close complex copy delete imag len make
builtin  max min new panic print println real recover

line-comment   //
block-comment  /* */
string   " "  : escapes
string   ' '  : escapes
string   ` `  : multiline
escape        : x=2 octal=3 u4 U8
operators  +-*/%&|^<>=!:~
calls

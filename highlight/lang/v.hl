# V: V documentation (vlang.io/docs, 0.4); requirements/languages/v.md
name     v vlang

keyword  as asm assert atomic break const continue defer else enum fn for go goto if import in
keyword  interface is isreftype lock match module mut none or pub return rlock select shared sizeof
keyword  spawn static struct type typeof union unsafe volatile __global __offsetof
type     bool string i8 i16 int i64 i128 u8 u16 u32 u64 u128 rune f32 f64 isize usize voidptr byteptr
type     charptr any
builtin  true false nil println print eprintln panic exit len cap

line-comment   //
block-comment  /* */  : nested
string   " "  : escapes interp=dollar
string   ' '  : escapes interp=dollar
string   ` `  : escapes
prefix   r    : literal
escape        : x=2 u4 octal=3
operators  +-*/%&|^!<>=:?~.
calls

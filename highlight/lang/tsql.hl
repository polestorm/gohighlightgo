# T-SQL: Transact-SQL reference (SQL Server 2022): reserved keywords, data types, variables; requirements/languages/tsql.md
extends  sql
name     tsql mssql t-sql

keyword  GO TOP NOCOUNT PRINT EXEC EXECUTE TRY CATCH THROW RAISERROR IDENTITY OUTPUT INSERTED DELETED
keyword  MERGE MATCHED TRAN WAITFOR CLUSTERED NONCLUSTERED PROC WHILE
type     NVARCHAR NCHAR NTEXT BIT TINYINT MONEY SMALLMONEY DATETIME DATETIME2 DATETIMEOFFSET
type     UNIQUEIDENTIFIER VARBINARY XML
builtin  GETDATE ISNULL NEWID SCOPE_IDENTITY CONVERT LEN DATEADD DATEDIFF ROW_NUMBER
string   [ ]  : name
sigil    @    : attr

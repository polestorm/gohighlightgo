# PL/SQL: Oracle Database PL/SQL Language Reference (23ai), Fundamentals and reserved words; requirements/languages/plsql.md
extends  sql
name     plsql pls

keyword  DECLARE BEGIN EXCEPTION LOOP EXIT CURSOR OPEN FETCH CLOSE RAISE PACKAGE BODY IS ELSIF WHILE
keyword  RECORD TYPE OF ROWTYPE PRAGMA AUTONOMOUS_TRANSACTION BULK COLLECT FORALL REPLACE OUT NOCOPY
type     VARCHAR2 NVARCHAR2 NUMBER PLS_INTEGER BINARY_INTEGER SIMPLE_INTEGER RAW LONG ROWID SYS_REFCURSOR
builtin  SQLERRM SQLCODE DBMS_OUTPUT PUT_LINE NVL DECODE SYSDATE TO_CHAR TO_DATE TO_NUMBER

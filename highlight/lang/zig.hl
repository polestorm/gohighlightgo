# Zig: Zig Language Reference (0.13), Keyword Reference, Primitive Types, String Literals; requirements/languages/zig.md
name     zig

keyword  addrspace align allowzero and anyframe anytype asm async await break callconv catch comptime
keyword  const continue defer else enum errdefer error export extern fn for if inline linksection noalias
keyword  noinline nosuspend opaque or orelse packed pub resume return struct suspend switch test
keyword  threadlocal try union unreachable usingnamespace var volatile while
type     i8 u8 i16 u16 i32 u32 i64 u64 i128 u128 isize usize c_char c_short c_ushort c_int c_uint c_long
type     c_ulong c_longlong c_ulonglong c_longdouble f16 f32 f64 f80 f128 bool anyopaque void noreturn
type     type anyerror comptime_int comptime_float
builtin  true false null undefined

line-comment   //
line-string    \\
string   " "  : escapes
string   ' '  : escapes
escape        : x=2 u-braces
number        : no-leading-dot
sigil    @    : builtin
operators  +-*/%&|^~<>=!?.:
calls

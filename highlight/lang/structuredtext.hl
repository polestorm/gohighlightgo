# IEC 61131-3 Structured Text: IEC 61131-3 (3rd edition), 7.3 Structured Text; requirements/languages/structuredtext.md
name     structuredtext iecst scl
keyword  PROGRAM END_PROGRAM FUNCTION END_FUNCTION FUNCTION_BLOCK END_FUNCTION_BLOCK VAR VAR_INPUT
keyword  VAR_OUTPUT VAR_IN_OUT VAR_GLOBAL END_VAR CONSTANT RETAIN IF THEN ELSIF ELSE END_IF CASE OF
keyword  END_CASE FOR TO BY DO END_FOR WHILE END_WHILE REPEAT UNTIL END_REPEAT RETURN EXIT AND OR XOR
keyword  NOT MOD AT TYPE END_TYPE STRUCT END_STRUCT
type     BOOL BYTE WORD DWORD INT DINT UINT UDINT REAL LREAL TIME DATE STRING ARRAY TON TOF CTU
builtin  TRUE FALSE
fold-case
line-comment   //
block-comment  (* *)
string   ' '  : doubled
string   " "  : doubled
operators  :=+-*/<>.;,[]#

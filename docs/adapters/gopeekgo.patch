diff --git a/preview/highlight.go b/preview/highlight.go
new file mode 100644
index 0000000..5707f1d
--- /dev/null
+++ b/preview/highlight.go
@@ -0,0 +1,32 @@
+//go:build !nohighlight
+
+// Kolorowanie składni bloków kodu biblioteką gohighlightgo, domyślnie włączone (ADR 0003); znacznik
+// nohighlight je wyłącza (nohighlight.go).
+package preview
+
+import (
+	"html"
+
+	"github.com/polestorm/gohighlightgo/highlight"
+	gomdgo "github.com/polestorm/gomdgo/markdown"
+)
+
+// highlightCSS: motyw auto, jasny albo ciemny według wyglądu systemu, jak reszta podglądu.
+var highlightCSS, _ = highlight.ThemeCSS("auto")
+
+// addHighlighting rejestruje każdą nazwę języka z gohighlightgo; mermaid zostaje przy diagramach.
+func addHighlighting(blocks map[string]gomdgo.CodeBlockFunc) {
+	for _, name := range highlight.Languages() {
+		if blocks[name] == nil {
+			blocks[name] = highlighted
+		}
+	}
+}
+
+// highlighted zapisuje blok tak jak gomdgo (<pre><code class="language-…">), z klasą hl dla motywu.
+func highlighted(b gomdgo.CodeBlock) ([]byte, error) {
+	code, _ := highlight.HTML(b.Lang, b.Code)
+	out := []byte(`<pre class="hl"><code class="language-` + html.EscapeString(b.Lang) + `">`)
+	out = append(out, code...)
+	return append(out, "</code></pre>\n"...), nil
+}

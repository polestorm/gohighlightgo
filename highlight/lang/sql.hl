# SQL: ISO/IEC 9075-2:2016 and words common in PostgreSQL, SQLite and MySQL; requirements/languages/sql.md
name     sql

keyword  ADD ALL ALTER AND ANY AS ASC AUTO_INCREMENT BEGIN BETWEEN BY CASCADE CASE CAST
keyword  CHECK COLLATE COLUMN COMMIT CONSTRAINT CREATE CROSS CURRENT_DATE CURRENT_TIME CURRENT_TIMESTAMP
keyword  CURRENT_USER DECLARE DEFAULT DELETE DESC DISTINCT DROP ELSE END ESCAPE EXCEPT EXISTS FETCH
keyword  FIRST FOR FOREIGN FROM FULL FUNCTION GRANT GROUP HAVING IF IN INDEX INNER INSERT INTERSECT INTO
keyword  IS JOIN KEY LEFT LIKE LIMIT NATURAL NEXT NOT OFFSET ON ONLY OR ORDER OUTER OVER PARTITION
keyword  PRIMARY PROCEDURE RECURSIVE REFERENCES RETURN RETURNS REVOKE RIGHT ROLLBACK ROW ROWS SELECT SET
keyword  SOME TABLE THEN TO TRANSACTION TRIGGER UNION UNIQUE UPDATE USING VALUES VIEW WHEN WHERE WINDOW
keyword  WITH
type     BIGINT BINARY BLOB BOOLEAN CHAR CHARACTER CLOB DATE DECIMAL DOUBLE FLOAT INT
type     INTEGER INTERVAL NUMERIC PRECISION REAL SMALLINT TEXT TIME TIMESTAMP VARBINARY VARCHAR VARYING
builtin  TRUE FALSE NULL UNKNOWN ABS AVG CHAR_LENGTH COALESCE COUNT LOWER MAX MIN NULLIF
builtin  SUBSTRING SUM TRIM UPPER
fold-case

line-comment   --
block-comment  /* */  : nested
string   ' '  : doubled multiline
string   " "  : doubled name
string   ` `  : doubled name
prefix   N X B E U&  : any-case
operators  +-*/%<>=!|&^~:
